<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sottovento Vasto — dove fa mare calmo oggi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --carta:#E7EEEE; --foglio:#FBFCFA; --linea:#C3D4D2;
  --inchiostro:#0F2E2C; --tenue:#5C7472; --mare:#146F72;
  --terra:#E4D9BC; --acqua:#CBE1E2; --vento:#B4402F; --onda:#14607A;
  --piatto:#17715A; --mosso:#A87A12; --agitato:#A33A2C; --raggio:3px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--carta);color:var(--inchiostro);font-family:"Barlow",system-ui,sans-serif;font-size:16px;line-height:1.45;-webkit-font-smoothing:antialiased}
.wrap{max-width:720px;margin:0 auto;padding:18px 14px 60px}
.eyebrow{font-family:"Barlow Semi Condensed";text-transform:uppercase;letter-spacing:.16em;font-size:12px;color:var(--tenue);margin:0 0 6px}
h1{font-family:"Instrument Serif";font-weight:400;font-size:40px;line-height:1.02;margin:0 0 8px;letter-spacing:-.01em}
h1 em{font-style:italic;color:var(--mare)}
.sottotitolo{margin:0 0 18px;color:var(--tenue);font-size:15px;max-width:46ch}
.comandi{background:var(--foglio);border:1px solid var(--linea);border-radius:var(--raggio);padding:12px;margin-bottom:16px}
.riga{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.riga+.riga{margin-top:10px}
.etichetta{font-family:"Barlow Semi Condensed";text-transform:uppercase;letter-spacing:.12em;font-size:11px;color:var(--tenue);width:100%;margin-bottom:-4px}
button{font-family:inherit;font-size:14px;cursor:pointer}
.tab{border:1px solid var(--linea);background:transparent;color:var(--inchiostro);padding:6px 12px;border-radius:var(--raggio)}
.tab[aria-pressed="true"]{background:var(--inchiostro);color:var(--foglio);border-color:var(--inchiostro)}
.tab:focus-visible,.ora:focus-visible{outline:2px solid var(--mare);outline-offset:2px}
.ore{display:flex;gap:6px;overflow-x:auto;padding:2px 0 6px}
.ora{flex:0 0 auto;border:1px solid var(--linea);background:var(--foglio);border-radius:var(--raggio);padding:5px 9px;min-width:52px;text-align:center;font-family:"Barlow Semi Condensed";font-size:14px;color:var(--inchiostro)}
.ora b{display:block;font-weight:600;font-size:15px}
.ora span{display:block;height:3px;margin-top:4px;border-radius:2px;background:var(--linea)}
.ora[aria-pressed="true"]{border-color:var(--inchiostro);box-shadow:inset 0 0 0 1px var(--inchiostro)}
.classifica{display:flex;flex-direction:column;gap:10px}
.scheda{background:var(--foglio);border:1px solid var(--linea);border-radius:var(--raggio);padding:12px;display:grid;grid-template-columns:78px 1fr;gap:12px;align-items:start}
.scheda.top{border-color:var(--inchiostro);box-shadow:0 1px 0 var(--inchiostro)}
.nome{font-family:"Instrument Serif";font-size:22px;line-height:1.1;margin:0}
.zona{font-family:"Barlow Semi Condensed";text-transform:uppercase;letter-spacing:.1em;font-size:11px;color:var(--tenue);margin:0}
.verdetto{margin:6px 0 0;font-size:15px}
.dati{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:8px;font-family:"Barlow Semi Condensed";font-size:14px;color:var(--tenue)}
.dati b{color:var(--inchiostro);font-weight:600}
.punteggio{float:right;font-family:"Barlow Semi Condensed";font-weight:600;font-size:26px;line-height:1;padding-left:10px}
.barra{display:flex;gap:2px;margin-top:9px}
.barra i{flex:1;height:16px;border-radius:1px;background:var(--linea)}
.barra i.now{outline:1px solid var(--inchiostro);outline-offset:1px}
.legenda-barra{font-family:"Barlow Semi Condensed";font-size:11px;color:var(--tenue);display:flex;justify-content:space-between;margin-top:2px;letter-spacing:.06em}
.nota{margin:8px 0 0;color:var(--tenue);font-family:"Instrument Serif";font-size:16px}
.affid{font-family:"Barlow Semi Condensed";font-size:11px;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--linea);border-radius:2px;padding:1px 5px;color:var(--tenue)}
footer{margin-top:26px;font-size:13px;color:var(--tenue);border-top:1px solid var(--linea);padding-top:12px}
footer p{margin:0 0 6px}
.stato{padding:24px 4px;color:var(--tenue);font-family:"Instrument Serif";font-size:20px}
.avviso{background:#F6EFD9;border:1px solid #D9C89A;border-radius:var(--raggio);padding:8px 10px;margin-bottom:12px;font-size:14px}
.errore{color:var(--agitato);font-family:"Barlow";font-size:15px}
@media (max-width:420px){h1{font-size:32px}.scheda{grid-template-columns:64px 1fr;gap:10px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <p class="eyebrow">Riserva di Punta Aderci · Costa dei Trabocchi · Vasto Marina</p>
  <h1>Da che parte è <em>sottovento</em></h1>
  <p class="sottotitolo">Le spiagge di Vasto non guardano tutte dalla stessa parte: da Punta Penna, che guarda a nord, a San Salvo, che guarda a nord-est. Con lo stesso vento, una è piatta e l'altra è mossa.</p>

  <div class="comandi">
    <div class="riga">
      <span class="etichetta">Cosa vuoi fare</span>
      <button class="tab" data-modo="bagno" aria-pressed="true">Bagno tranquillo</button>
      <button class="tab" data-modo="vento" aria-pressed="false">Vento e onda</button>
    </div>
    <div class="riga">
      <span class="etichetta">Giorno</span>
      <div id="giorni" class="riga" style="gap:8px"></div>
    </div>
    <div class="riga" style="display:block">
      <span class="etichetta">Ora</span>
      <div class="ore" id="ore"></div>
    </div>
  </div>

  <div id="avvisi"></div>
  <div id="stato" class="stato">Carico vento, onde e temperatura del mare…</div>
  <div class="classifica" id="classifica"></div>

  <footer>
    <p><b>Dati:</b> Open-Meteo — modelli ICON (DWD) e GFS (NOAA) per il vento, modello d'onda per altezza e direzione.</p>
    <p><b>Affidabilità:</b> quanto i due modelli concordano su direzione e intensità del vento a quell'ora.</p>
    <p><b>Punteggio:</b> 100 = acqua piatta e vento da terra. Scende con il vento che soffia dal mare verso la spiaggia e con l'onda frontale. In modalità vento il punteggio premia l'opposto.</p>
    <p>Esposizioni e ripari sono stime geografiche: si correggono nell'elenco <code>SPIAGGE</code> in cima allo script.</p>
  </footer>
</div>

<script>
/* ===================================================================
   SPIAGGE — coordinate reali, da nord a sud
   facing : direzione verso cui guarda il mare davanti alla spiaggia
   riparo : settori di provenienza schermati da promontori o moli
            v = quanto resta del vento, o = quanto resta dell'onda
   =================================================================== */
const SPIAGGE = [
  { id:'mottagrossa', nome:'Mottagrossa', zona:'riserva, ciottoli', lat:42.1829, lon:14.6728,
    facing:35, riparo:[{da:120,a:205,v:.85,o:.6}],
    nota:'Lunga e solitaria, aperta al quadrante nord-est.' },

  { id:'aderci', nome:'Punta Aderci', zona:'sotto il promontorio', lat:42.1796, lon:14.6857,
    facing:20, riparo:[{da:80,a:210,v:.6,o:.3}],
    nota:'Il promontorio la copre da levante e scirocco; con la tramontana è la prima a saltare.' },

  { id:'libertini', nome:'Libertini', zona:'riserva, sabbia e ghiaia', lat:42.1772, lon:14.6915,
    facing:22, riparo:[{da:95,a:215,v:.65,o:.35},{da:230,a:330,v:.75,o:.5}],
    nota:'Incassata fra Aderci e Punta Penna: il tratto più riparato dai venti meridionali.' },

  { id:'pennuccia', nome:'Punta Penna', zona:'la Pennuccia, sabbia dorata', lat:42.1740, lon:14.7033,
    facing:25, riparo:[{da:75,a:230,v:.55,o:.25}],
    nota:'Guarda a nord: con scirocco e garbino resta uno specchio, con grecale no.' },

  { id:'canale', nome:'La Canale', zona:'fra due trabocchi', lat:42.1392, lon:14.7186,
    facing:80, riparo:[{da:315,a:15,v:.9,o:.6}],
    nota:'Ciottoli e scogli affioranti, poco parcheggio: meglio la mattina presto.' },

  { id:'sannicola', nome:'San Nicola', zona:'ciottoli, la più ampia', lat:42.1321, lon:14.7200,
    facing:82, riparo:[{da:315,a:15,v:.92,o:.65}],
    nota:'Esposta ai venti da nord: dà il meglio con libeccio e garbino.' },

  { id:'casarza', nome:'Casarza', zona:'sotto la falesia', lat:42.1186, lon:14.7201,
    facing:90, riparo:[{da:310,a:20,v:.88,o:.6}],
    nota:'Un po\u2019 più riparata delle vicine, fondale che scende subito.' },

  { id:'trave', nome:'Trave', zona:'trabocco e ciottoli', lat:42.1122, lon:14.7196,
    facing:88, riparo:[{da:310,a:20,v:.9,o:.65}],
    nota:'Piccola e appartata, nessun servizio: acqua limpida nelle giornate ferme.' },

  { id:'vastomarina', nome:'Vasto Marina', zona:'sabbia, stabilimenti', lat:42.1007, lon:14.7216,
    facing:62, riparo:[{da:300,a:10,v:.92,o:.7}],
    nota:'Fondale dolce e tutti i servizi: la scelta comoda quando il mare è ovunque uguale.' },

  { id:'sansalvo', nome:'San Salvo Marina', zona:'sabbia, a sud', lat:42.0744, lon:14.7667,
    facing:45, riparo:[{da:300,a:350,v:.95,o:.85}],
    nota:'Orientata a nord-est: regge il maestrale, soffre il grecale.' }
];

/* ---------------- utilità ---------------- */
const rad=d=>d*Math.PI/180, norm=d=>((d%360)+360)%360;
const diffAng=(a,b)=>{const d=Math.abs(norm(a)-norm(b));return d>180?360-d:d;};
const inSettore=(dir,da,a)=>{dir=norm(dir);da=norm(da);a=norm(a);return da<=a?(dir>=da&&dir<=a):(dir>=da||dir<=a);};
const NOMI=[[0,'tramontana'],[45,'grecale'],[90,'levante'],[135,'scirocco'],[180,'ostro'],[225,'libeccio'],[270,'ponente'],[315,'maestrale']];
function nomeVento(d){let b=NOMI[0],bd=999;for(const n of NOMI){const s=diffAng(d,n[0]);if(s<bd){bd=s;b=n;}}return b[1];}
const CARD=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSO','SO','OSO','O','ONO','NO','NNO'];
const sigla=d=>CARD[Math.round(norm(d)/22.5)%16];

// punto al largo (~3 km nella direzione di esposizione) per il moto ondoso
SPIAGGE.forEach(s=>{
  s.mare=[ +(s.lat+0.027*Math.cos(rad(s.facing))).toFixed(4),
           +(s.lon+0.036*Math.sin(rad(s.facing))).toFixed(4) ];
});

const GIORNI=3;
const lats=SPIAGGE.map(s=>s.lat).join(','), lons=SPIAGGE.map(s=>s.lon).join(',');
const mlats=SPIAGGE.map(s=>s.mare[0]).join(','), mlons=SPIAGGE.map(s=>s.mare[1]).join(',');

/* ---------------- rete, con ripieghi ---------------- */
async function json(url){
  const r=await fetch(url,{cache:'no-store'});
  let j=null;
  try{ j=await r.json(); }catch(e){ throw new Error('risposta non leggibile ('+r.status+')'); }
  if(!r.ok||(j&&j.error)) throw new Error((j&&j.reason)||('HTTP '+r.status));
  return Array.isArray(j)?j:[j];
}
const paramiVento='&hourly=wind_speed_10m,wind_direction_10m,wind_gusts_10m,temperature_2m'
  +'&wind_speed_unit=kmh&timezone=Europe%2FRome&forecast_days='+GIORNI;
const urlVento=(la,lo,mod)=>'https://api.open-meteo.com/v1/forecast?latitude='+la+'&longitude='+lo
  +paramiVento+(mod?'&models='+mod:'');

async function caricaVento(){
  // 1) due modelli, tutte le località in una chiamata
  try{ return {r:await json(urlVento(lats,lons,'icon_seamless,gfs_seamless')), due:true}; }catch(e){ log('vento 2 modelli: '+e.message); }
  // 2) due modelli, una chiamata per località
  try{
    return {r:await Promise.all(SPIAGGE.map(async s=>(await json(urlVento(s.lat,s.lon,'icon_seamless,gfs_seamless')))[0])), due:true};
  }catch(e){ log('vento per località: '+e.message); }
  // 3) modello automatico, tutte le località
  try{ return {r:await json(urlVento(lats,lons,null)), due:false}; }catch(e){ log('vento modello unico: '+e.message); }
  // 4) modello automatico, una chiamata per località
  return {r:await Promise.all(SPIAGGE.map(async s=>(await json(urlVento(s.lat,s.lon,null)))[0])), due:false};
}

const urlMare=(la,lo,sst)=>'https://marine-api.open-meteo.com/v1/marine?latitude='+la+'&longitude='+lo
  +'&hourly=wave_height,wave_direction,wave_period'+(sst?',sea_surface_temperature':'')
  +'&timezone=Europe%2FRome&forecast_days='+GIORNI;

async function caricaMare(){
  try{ return {r:await json(urlMare(mlats,mlons,true)), sst:true}; }catch(e){ log('onde+temperatura: '+e.message); }
  try{ return {r:await json(urlMare(mlats,mlons,false)), sst:false}; }catch(e){ log('onde: '+e.message); }
  try{
    return {r:await Promise.all(SPIAGGE.map(async s=>(await json(urlMare(s.mare[0],s.mare[1],false)))[0])), sst:false};
  }catch(e){ log('onde per località: '+e.message); return null; }
}

const DIAGNOSI=[];
function log(m){ DIAGNOSI.push(m); }
function avviso(testo){
  document.getElementById('avvisi').insertAdjacentHTML('beforeend','<div class="avviso">'+testo+'</div>');
}

/* ---------------- dati ---------------- */
let DATI=null, ORE=[], idxOra=0, modo='bagno', dueModelli=true, conOnde=true;

function serie(h,campo,mod){
  if(mod&&Array.isArray(h[campo+'_'+mod])) return h[campo+'_'+mod];
  return Array.isArray(h[campo])?h[campo]:[];
}
function vicino(arr,i){
  if(!arr||!arr.length) return null;
  if(arr[i]!=null) return arr[i];
  for(let k=1;k<24;k++){ if(arr[i-k]!=null) return arr[i-k]; if(arr[i+k]!=null) return arr[i+k]; }
  return null;
}

async function carica(){
  const v=await caricaVento();
  dueModelli=v.due;
  const m=await caricaMare();
  conOnde=!!m;
  ORE=v.r[0].hourly.time;

  DATI=SPIAGGE.map((s,i)=>{
    const h=v.r[i]?v.r[i].hourly:v.r[0].hourly;
    const mh=(m&&m.r[i])?m.r[i].hourly:null;
    const mod1=dueModelli?'icon_seamless':null, mod2=dueModelli?'gfs_seamless':null;
    return {
      spiaggia:s,
      vi:{s:serie(h,'wind_speed_10m',mod1),d:serie(h,'wind_direction_10m',mod1),g:serie(h,'wind_gusts_10m',mod1)},
      vg:dueModelli?{s:serie(h,'wind_speed_10m',mod2),d:serie(h,'wind_direction_10m',mod2)}:null,
      aria:serie(h,'temperature_2m',mod1),
      onda:mh?mh.wave_height:[], ondaDir:mh?mh.wave_direction:[],
      periodo:mh?mh.wave_period:[], sst:(mh&&m.sst)?mh.sea_surface_temperature:[]
    };
  });
  // se una serie d'onda è tutta vuota, prende la media delle altre
  if(conOnde){
    const buone=DATI.filter(d=>d.onda.some(x=>x!=null));
    DATI.forEach(d=>{ if(!d.onda.some(x=>x!=null)&&buone.length){ d.onda=buone[0].onda; d.ondaDir=buone[0].ondaDir; d.periodo=buone[0].periodo; } });
    if(!buone.length) conOnde=false;
  }
}

/* ---------------- calcolo ---------------- */
function mediaAngoli(a,b){const x=Math.cos(rad(a))+Math.cos(rad(b)),y=Math.sin(rad(a))+Math.sin(rad(b));return norm(Math.atan2(y,x)*180/Math.PI);}

function condizioni(d,i){
  const s=d.spiaggia;
  const si=vicino(d.vi.s,i), di=vicino(d.vi.d,i), gi=vicino(d.vi.g,i);
  const sg=d.vg?vicino(d.vg.s,i):null, dg=d.vg?vicino(d.vg.d,i):null;
  const vs=(sg!=null)?(si+sg)/2:si;
  const vd=(dg!=null)?mediaAngoli(di,dg):di;
  const raffica=gi!=null?gi:vs;

  let oh=conOnde?vicino(d.onda,i):null, od=conOnde?vicino(d.ondaDir,i):null;
  const per=vicino(d.periodo,i), sst=vicino(d.sst,i);
  if(oh==null) oh=0;
  if(od==null) od=s.facing;

  let fv=1,fo=1;
  for(const r of (s.riparo||[])){
    if(inSettore(vd,r.da,r.a)) fv=Math.min(fv,r.v);
    if(inSettore(od,r.da,r.a)) fo=Math.min(fo,r.o);
  }
  const ventoEff=vs*fv, raffEff=raffica*fv, ondaEff=oh*fo;
  const comp=ventoEff*Math.cos(rad(vd-s.facing));           // >0 dal mare, <0 da terra
  const frontale=ondaEff*Math.max(0,Math.cos(rad(od-s.facing)));

  let aff='n.d.';
  if(sg!=null){
    const dd=diffAng(di,dg), ds=Math.abs(si-sg);
    aff=(dd>60||ds>15)?'bassa':(dd>30||ds>8)?'media':'alta';
  }

  let punti;
  if(modo==='bagno'){
    punti=100-Math.max(0,comp)*2.3-frontale*60-ondaEff*10
          +Math.min(Math.max(0,-comp),25)*0.35-Math.max(0,raffEff-30)*0.6;
  }else{
    const forza=100-Math.abs(vs-24)*3.4;
    const lat=Math.abs(Math.sin(rad(vd-s.facing)));
    punti=forza*0.72+Math.max(0,comp)*0.9+lat*12+Math.min(oh,1.2)*18;
    if(vs<8) punti-=25;
  }
  return {vs,vd,raffica,ventoEff,comp,onda:oh,ondaEff,ondaDir:od,frontale,periodo:per,sst,
          aria:vicino(d.aria,i),punti:Math.max(0,Math.min(100,Math.round(punti))),aff};
}
const colore=p=>p>=70?'var(--piatto)':p>=45?'var(--mosso)':'var(--agitato)';

function verdetto(c){
  if(modo==='vento'){
    if(c.vs<8) return ['Bonaccia','vento sotto gli 8 km/h'];
    if(c.punti>=70) return ['Si naviga',nomeVento(c.vd)+' a '+Math.round(c.vs)+' km/h'+(conOnde?', onda '+c.onda.toFixed(1)+' m':'')];
    if(c.punti>=45) return ['Si prova','vento discontinuo o troppo di terra'];
    return ['Poco adatta','vento debole o mal orientato per questa esposizione'];
  }
  const dir=c.comp>3?'in faccia':c.comp<-3?'da terra':'di lato';
  const onda=conOnde?', onda '+c.ondaEff.toFixed(1)+' m':'';
  if(c.punti>=80) return ['Acqua piatta',nomeVento(c.vd)+' '+dir+onda];
  if(c.punti>=65) return ['Quasi ferma',nomeVento(c.vd)+' '+dir+' a '+Math.round(c.ventoEff)+' km/h'];
  if(c.punti>=45) return ['Increspata',nomeVento(c.vd)+' '+dir+onda];
  if(c.punti>=25) return ['Mossa',(conOnde?'onda frontale '+c.frontale.toFixed(1)+' m con ':'')+nomeVento(c.vd)];
  return ['Da evitare',nomeVento(c.vd)+' teso in faccia'+onda];
}

/* ---------------- quadrante ---------------- */
function quadrante(s,c){
  const R=30,cx=34,cy=34,f=s.facing;
  const P=(a,r)=>[cx+r*Math.sin(rad(a)),cy-r*Math.cos(rad(a))];
  const arco=(da,a,r)=>{const[x1,y1]=P(da,r),[x2,y2]=P(a,r);return `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 0 1 ${x2} ${y2} Z`;};
  const[wx1,wy1]=P(c.vd,R+1),[wx2,wy2]=P(c.vd,13);
  let onda='';
  if(conOnde&&c.ondaEff>=0.15){const[ox1,oy1]=P(c.ondaDir,R-4),[ox2,oy2]=P(c.ondaDir,19);
    onda=`<line x1="${ox1.toFixed(1)}" y1="${oy1.toFixed(1)}" x2="${ox2.toFixed(1)}" y2="${oy2.toFixed(1)}" stroke="var(--onda)" stroke-width="1.6" stroke-dasharray="2 2"/>`;}
  const[bx1,by1]=P(f-90,R),[bx2,by2]=P(f+90,R);
  return `<svg viewBox="0 0 68 78" width="100%" aria-hidden="true">
    <defs><marker id="p${s.id}" markerWidth="6" markerHeight="6" refX="4.5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="var(--vento)"/></marker></defs>
    <circle cx="${cx}" cy="${cy}" r="${R}" fill="var(--terra)" stroke="var(--linea)"/>
    <path d="${arco(f-90,f+90,R)}" fill="var(--acqua)"/>
    <path d="${arco(f-90,f+90,R)}" fill="none" stroke="var(--linea)"/>
    <line x1="${bx1.toFixed(1)}" y1="${by1.toFixed(1)}" x2="${bx2.toFixed(1)}" y2="${by2.toFixed(1)}" stroke="var(--inchiostro)" stroke-width="1.6"/>
    ${onda}
    <line x1="${wx1.toFixed(1)}" y1="${wy1.toFixed(1)}" x2="${wx2.toFixed(1)}" y2="${wy2.toFixed(1)}" stroke="var(--vento)" stroke-width="2.4" marker-end="url(#p${s.id})"/>
    <circle cx="${cx}" cy="${cy}" r="2" fill="var(--inchiostro)"/>
    <text x="${cx}" y="7" text-anchor="middle" font-size="8" fill="var(--tenue)" font-family="Barlow Semi Condensed">N</text>
    <text x="${cx}" y="76" text-anchor="middle" font-size="10" fill="var(--tenue)" font-family="Barlow Semi Condensed">guarda a ${sigla(f)}</text>
  </svg>`;
}

/* ---------------- interfaccia ---------------- */
function costruisciGiorni(){
  const box=document.getElementById('giorni'); box.innerHTML='';
  const et=['Oggi','Domani','Dopodomani'];
  [...new Set(ORE.map(t=>t.slice(0,10)))].slice(0,GIORNI).forEach((g,n)=>{
    const b=document.createElement('button');
    b.className='tab'; b.dataset.giorno=g;
    b.textContent=et[n]||g.slice(8,10)+'/'+g.slice(5,7);
    b.onclick=()=>{const t=ORE.findIndex(x=>x.startsWith(g)&&+x.slice(11,13)>=9);
      idxOra=t>=0?t:ORE.findIndex(x=>x.startsWith(g)); disegna();};
    box.appendChild(b);
  });
}
function costruisciOre(){
  const box=document.getElementById('ore'); box.innerHTML='';
  const giorno=ORE[idxOra].slice(0,10);
  ORE.forEach((t,i)=>{
    if(!t.startsWith(giorno)) return;
    const h=+t.slice(11,13); if(h<6||h>21) return;
    const b=document.createElement('button');
    b.className='ora'; b.setAttribute('aria-pressed',i===idxOra);
    const max=Math.max(...DATI.map(d=>condizioni(d,i).punti));
    b.innerHTML=`<b>${String(h).padStart(2,'0')}</b><span style="background:${colore(max)}"></span>`;
    b.onclick=()=>{idxOra=i;disegna();};
    box.appendChild(b);
  });
  const sel=box.querySelector('[aria-pressed="true"]');
  if(sel) sel.scrollIntoView({block:'nearest',inline:'center'});
  document.querySelectorAll('#giorni .tab').forEach(t=>t.setAttribute('aria-pressed',t.dataset.giorno===giorno));
}
function barraGiornata(d){
  const giorno=ORE[idxOra].slice(0,10); let out='';
  ORE.forEach((t,i)=>{
    if(!t.startsWith(giorno)) return;
    const h=+t.slice(11,13); if(h<8||h>20) return;
    const p=condizioni(d,i).punti;
    out+=`<i class="${i===idxOra?'now':''}" style="background:${colore(p)};opacity:${0.35+p/160}" title="${h}:00 — ${p}"></i>`;
  });
  return `<div class="barra">${out}</div><div class="legenda-barra"><span>8</span><span>14</span><span>20</span></div>`;
}
function disegna(){
  const lista=DATI.map(d=>({d,c:condizioni(d,idxOra)})).sort((a,b)=>b.c.punti-a.c.punti);
  const box=document.getElementById('classifica'); box.innerHTML='';
  lista.forEach((r,n)=>{
    const s=r.d.spiaggia,c=r.c,v=verdetto(c);
    const el=document.createElement('article');
    el.className='scheda'+(n===0?' top':'');
    el.innerHTML=`<div>${quadrante(s,c)}</div><div>
      <span class="punteggio" style="color:${colore(c.punti)}">${c.punti}</span>
      <p class="zona">${s.zona}</p>
      <h2 class="nome">${s.nome}</h2>
      <p class="verdetto"><b>${v[0]}.</b> ${v[1]}.</p>
      <div class="dati">
        <span>vento <b>${Math.round(c.vs)} km/h</b> da ${sigla(c.vd)} · ${nomeVento(c.vd)}</span>
        <span>raffiche <b>${Math.round(c.raffica)}</b></span>
        ${conOnde?`<span>onda <b>${c.onda.toFixed(1)} m</b>${c.periodo?' · '+Math.round(c.periodo)+' s':''}</span>`:''}
        ${c.sst!=null?`<span>mare <b>${c.sst.toFixed(1)}°</b></span>`:''}
        ${c.aria!=null?`<span>aria <b>${Math.round(c.aria)}°</b></span>`:''}
        <span class="affid">affidabilità ${c.aff}</span>
      </div>
      ${barraGiornata(r.d)}
      <p class="nota">${s.nota}</p></div>`;
    box.appendChild(el);
  });
  costruisciOre();
}
document.querySelectorAll('[data-modo]').forEach(b=>{
  b.onclick=()=>{modo=b.dataset.modo;
    document.querySelectorAll('[data-modo]').forEach(x=>x.setAttribute('aria-pressed',x===b));
    disegna();};
});

carica().then(()=>{
  const n=new Date();
  const chiave=n.getFullYear()+'-'+String(n.getMonth()+1).padStart(2,'0')+'-'+String(n.getDate()).padStart(2,'0')+'T'+String(n.getHours()).padStart(2,'0')+':00';
  const i=ORE.indexOf(chiave); idxOra=i>=0?i:0;
  document.getElementById('stato').remove();
  if(!dueModelli) avviso('Un solo modello disponibile in questo momento: l\u2019affidabilità non è calcolabile.');
  if(!conOnde) avviso('Modello d\u2019onda non raggiungibile: il punteggio tiene conto del solo vento.');
  costruisciGiorni(); disegna();
}).catch(e=>{
  const rete = /load failed|failed to fetch|networkerror|cors/i.test(e.message);
  const sandbox = window.self!==window.top;
  document.getElementById('stato').innerHTML='<span class="errore"><b>Previsioni non raggiungibili.</b><br>'
    + (rete
        ? 'La pagina non è riuscita a uscire su internet'
          + (sandbox ? ', perché sta girando dentro un\u2019anteprima che blocca le richieste esterne. Aprila in Safari o Chrome, oppure caricala sul tuo sito: lì funziona.' : '. Controlla la connessione e ricarica.')
        : e.message)
    + '<br><br><button class="tab" id="prova" style="margin-top:6px">Vedi l\u2019interfaccia con dati di prova</button>'
    + '<br><br><small>Dettaglio tentativi:<br>'+(DIAGNOSI.join('<br>')||'nessuno')+'</small></span>';
  document.getElementById('prova').onclick=modalitaProva;
});

/* Dati inventati: servono solo a controllare grafica e punteggi
   quando la rete è bloccata. Non sono previsioni. */
function modalitaProva(){
  const ore=[], base=new Date(); base.setMinutes(0,0,0);
  for(let k=0;k<72;k++){ const t=new Date(base.getTime()+k*3600000);
    ore.push(t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0')+'T'+String(t.getHours()).padStart(2,'0')+':00'); }
  ORE=ore; dueModelli=true; conOnde=true;
  const n=ore.length;
  const dir=[], vel=[], raf=[], oh=[], od=[], per=[], sst=[], ari=[];
  for(let k=0;k<n;k++){
    const d=norm(20+k*3.4), v=9+9*Math.sin(k/7)+6*Math.sin(k/3.1);
    dir.push(d); vel.push(Math.max(2,v)); raf.push(Math.max(3,v*1.5));
    oh.push(Math.max(0.05,0.25+0.35*Math.sin(k/6))); od.push(norm(d+15));
    per.push(4+Math.sin(k/5)); sst.push(24.5+0.4*Math.sin(k/12)); ari.push(26+4*Math.sin((k-4)/3.8));
  }
  DATI=SPIAGGE.map(s=>({spiaggia:s,
    vi:{s:vel,d:dir,g:raf}, vg:{s:vel.map(x=>x*1.1),d:dir.map(x=>norm(x+12))},
    aria:ari, onda:oh, ondaDir:od, periodo:per, sst:sst}));
  idxOra=0;
  document.getElementById('stato').remove();
  avviso('<b>Dati di prova.</b> Servono solo a vedere come si comporta la pagina: non sono previsioni reali.');
  costruisciGiorni(); disegna();
}
</script>
